# ACE receptor — the execution mesh node, built from upstream Go source.
#
# Built before the controller, not after: AWX's own image copies the receptor
# binary in from a receptor image rather than compiling it, and this build does
# the same.

ARG RECEPTOR_REF=devel
ARG GO_VERSION=1.25

###############################################################################
# Stage 1 — compile
###############################################################################
FROM docker.io/library/golang:${GO_VERSION} AS builder
ARG RECEPTOR_REF
WORKDIR /src
RUN git clone https://github.com/ansible/receptor.git . && git checkout "${RECEPTOR_REF}"
# Matches the flags receptor's own Makefile uses. -buildvcs=false is required:
# the build runs on a shallow clone with no usable VCS metadata.
RUN CGO_ENABLED=0 GOFLAGS="-buildvcs=false" go build -o /out/receptor ./cmd/receptor-cl

###############################################################################
# Stage 2 — runtime
###############################################################################
FROM quay.io/centos/centos:stream9
# podman is installed here rather than mounted from the host. The vendor's
# installer mounts a host binary, which only works if the container carries the
# libraries that binary was linked against — mounting /usr/bin/podman straight
# in fails at exec with `libsubid.so.6: cannot open shared object file`, and
# receptor reports that as a missing work-unit status file.
# dumb-init lives in EPEL, not the base repos — the same trap as the EDA image.
RUN dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm && \
    dnf install -y python3.12 python3.12-pip podman fuse-overlayfs dumb-init && \
    dnf clean all && \
    pip3.12 install --no-cache-dir receptorctl ansible-runner

COPY --from=builder /out/receptor /usr/bin/receptor

# /home/runner is podman's HOME inside this container, so it must be owned by
# the uid the container actually runs as — with keep-id that is the host user's,
# 1000. Group-root alone is not enough: podman refuses a config directory it
# does not own outright ("exists and it is not owned by the current user").
RUN mkdir -p /etc/receptor /var/lib/receptor /run/receptor \
             /home/runner/.config /home/runner/.local/share && \
    chgrp -R 0 /etc/receptor /var/lib/receptor /run/receptor && \
    chmod -R g=u /etc/receptor /var/lib/receptor /run/receptor && \
    chown -R 1000:0 /home/runner && chmod -R g=u /home/runner

RUN useradd -u 1000 -g 0 -d /home/runner -M -s /bin/bash runner 2>/dev/null || true

# useradd hands the new user a subuid/subgid range, and the podman inside
# this container will try to use it. It cannot: newuidmap is not setuid here,
# and the outer namespace has exactly one UID mapped anyway, so the attempt
# fails with `newuidmap: write to uid_map failed: Operation not permitted`.
# Take the ranges away and the inner podman falls back to single-UID mode,
# which is the arrangement ignore_chown_errors exists to accommodate.
RUN : > /etc/subuid && : > /etc/subgid

ENV HOME=/home/runner
USER 1000
WORKDIR /

# dumb-init as PID 1, like every vendor image. receptor spawns ansible-runner
# which spawns podman which spawns a job; without an init that reaps, the
# container accumulates zombies over a long-running mesh node.
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/bin/receptor", "-c", "/etc/receptor/receptor.conf"]
