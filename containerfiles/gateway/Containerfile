# ACE gateway — the platform gateway (jewel) with the unified console baked in,
# built entirely from Apache-2.0 upstream source.
#
#   ansible/jewel      -> the gateway application   (JEWEL_REF)
#   ansible/ansible-ui -> the platform console      (ANSIBLE_UI_REF)
#
# Both are pinned to a commit. A moving branch is not reproducible, and this
# tutorial is meant to still build in a year.

ARG JEWEL_REF=cd1fd8e657f873f2b7c328cf3acc8696f23fb2ed
ARG ANSIBLE_UI_REF=75d1264624fcf08777f72fcaaeaeb93d9d4a90d1
ARG PYTHON=python3.12

###############################################################################
# Stage 1 — fetch the gateway source at a pinned commit
###############################################################################
FROM quay.io/centos/centos:stream9 AS jewel-src
ARG JEWEL_REF
RUN dnf install -y git && dnf clean all
WORKDIR /src
RUN git clone https://github.com/ansible/jewel.git . && git checkout "${JEWEL_REF}"

###############################################################################
# Stage 2 — build the console with node. Node exists only in this stage.
###############################################################################
FROM docker.io/library/node:20-bookworm AS ui-builder
ARG ANSIBLE_UI_REF
WORKDIR /ui
RUN git clone https://github.com/ansible/ansible-ui.git . && git checkout "${ANSIBLE_UI_REF}"
RUN npm ci
RUN cd platform && NODE_OPTIONS=--max-old-space-size=8192 npm run build

###############################################################################
# Stage 3 — the virtualenv
###############################################################################
FROM quay.io/centos/centos:stream9 AS builder
ARG PYTHON

ENV LANG=en_US.UTF-8
ENV DJANGO_SETTINGS_MODULE=aap_gateway_api.settings
ENV PYTHONUNBUFFERED=1

RUN sed -i '/^\[crb\]$/,/^enabled=0$/ s/enabled=0/enabled=1/' /etc/yum.repos.d/centos.repo && \
    dnf install -y \
      git gcc "${PYTHON}-devel" "${PYTHON}" "${PYTHON}-pip" \
      libpq libpq-devel libtool-ltdl-devel openldap-devel \
      postgresql xmlsec1-devel && \
    dnf clean all

RUN mkdir -p /opt/aap_gateway && chgrp -R 0 /opt/aap_gateway && chmod -R g=u /opt/aap_gateway
RUN "/usr/bin/${PYTHON}" -m venv /opt/aap_gateway/venv
RUN echo "/opt/aap_gateway/aap_gateway" > "/opt/aap_gateway/venv/lib/${PYTHON}/site-packages/project.pth"
RUN /opt/aap_gateway/venv/bin/pip install --upgrade 'setuptools>=65.5.1'

COPY --from=jewel-src /src/requirements/requirements.txt /tmp/requirements.txt
COPY --from=jewel-src /src/requirements/requirements_git.txt /tmp/requirements_git.txt
RUN /opt/aap_gateway/venv/bin/pip --no-cache-dir install -r /tmp/requirements.txt
RUN /opt/aap_gateway/venv/bin/pip --no-cache-dir install -r /tmp/requirements_git.txt

###############################################################################
# Stage 4 — the runtime. No compilers, no node, no git.
###############################################################################
FROM quay.io/centos/centos:stream9
ARG PYTHON

RUN dnf module install -y nginx:1.24/common && \
    dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm && \
    dnf install -y \
      dumb-init inotify-tools less libpq postgresql \
      "${PYTHON}" "${PYTHON}-pip" supervisor xmlsec1-openssl && \
    dnf clean all

RUN useradd -u 1000 -g 0 -d /var/lib/ansible-automation-platform -m -s /sbin/nologin gateway

COPY --from=builder   /opt/aap_gateway /opt/aap_gateway
COPY --from=jewel-src /src/tools/scripts/launch-gateway      /usr/bin/launch-gateway
COPY --from=jewel-src /src/tools/scripts/auto-reload         /usr/bin/auto-reload
COPY --from=jewel-src /src/tools/scripts/aap-gateway-manage  /usr/bin/aap-gateway-manage
COPY --from=jewel-src /src/tools/configs/nginx.conf          /etc/ansible-automation-platform/gateway/nginx.conf
COPY --from=jewel-src /src/tools/configs/nginx-gateway.conf  /etc/ansible-automation-platform/gateway/nginx-gateway.conf
COPY --from=jewel-src /src/tools/configs/uwsgi.ini           /etc/ansible-automation-platform/gateway/uwsgi.ini
COPY --from=jewel-src /src/tools/configs/supervisord.conf    /etc/supervisord.conf
COPY --from=jewel-src /src/tools/configs/settings.py         /etc/ansible-automation-platform/gateway/settings.py

RUN for dir in /etc/nginx /opt/aap_gateway /opt/aap_gateway/src \
               /var/log/supervisor /var/run/supervisor /var/run/uwsgi \
               /var/log/nginx /var/run/django_metrics \
               /var/cache/ansible-automation-platform/gateway ; \
    do mkdir -m 0775 -p "$dir" ; chmod g+rwx "$dir" ; chgrp root "$dir" ; done && \
    for file in /etc/nginx/gateway.crt /etc/nginx/gateway.key ; \
    do touch "$file" ; chmod g+rw "$file" ; chgrp root "$file" ; done && \
    ln -s /usr/bin/aap-gateway-manage /usr/bin/gateway-manage

ENV PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

COPY --from=jewel-src /src/aap_gateway_api /opt/aap_gateway/src/aap_gateway_api/
ENV PATH=/opt/aap_gateway/venv/bin:$PATH
ENV PYTHONPATH=/opt/aap_gateway/src
ENV DJANGO_SETTINGS_MODULE=aap_gateway_api.settings

COPY --from=ui-builder /ui/platform/dist /opt/aap_gateway/platform_ui

RUN GATEWAY_SECRET_KEY_FILE=/dev/null aap-gateway-manage collectstatic --noinput && \
    chgrp -R root /opt/aap_gateway/static && chmod -R g=u /opt/aap_gateway/static

USER gateway
EXPOSE 8000
WORKDIR /opt
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/usr/bin/launch-gateway"]
