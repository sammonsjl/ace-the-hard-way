# Terraform state and provider plugins. State is per-machine and describes
# disks on YOUR host — never commit it.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/ssh_config
*.log

.vagrant/
*.vmdk

# Local Claude settings and context — not part of the tutorial
.claude/settings.local.json
.claudian/
.e2e/
CLAUDE.md

# Editor and filesystem metadata that appears when the repo is opened in
# Obsidian or lives on a Synology share. Neither belongs to the tutorial.
.obsidian/
@eaDir/

# Working notes from test runs — version pins and war stories for the author,
# not part of the tutorial. Contains throwaway lab credentials.
E2E-TEST.md

# Reference material and notes taken from it. The tutorial is written from
# upstream sources; these are the author's verification notes and must not ship.
downloads/
docs/bundle-facts.md

# Cert courier files. /srv/ace in the VMs IS this directory, so anything the
# labs hand between the nodes through it lands right here. Root-anchored on
# purpose — per-deployment key material must never be committed, and a reader
# must never inherit someone else's CA or work-signing keys from the repo.
/*.crt
/*.csr
/*.key
/*.pem
